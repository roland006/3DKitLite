  m_Script: {fileID: 11500000, guid: 97933d85c6acddc4bb95f77ca8cc0280, type: 3}
  m_Name: EnglishInformationPoints
  m_EditorClassIdentifier: 
  language: English
  phrases:
  - key: INFO1
    value: "\u0422\u0435\u043A\u0441\u0442 \u0437\u0430\u043F\u0438\u0441\u043A\u0438:
      \xAB\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435: \u043D\u0430\u0448\u0438
      \u043F\u043E\u0434\u043E\u043F\u044B\u0442\u043D\u044B\u0435 \u043C\u0443\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438,
      \u043D\u043E \u043C\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0434\u0435\u043B\u0430\u043B\u0438, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u044D\u0442\u043E \u0441\u0430\u0431\u043E\u0442\u0430\u0436? \u041C\u0435\u043D\u044F
      \u043F\u0443\u0433\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u043D\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F.\xBB "
  - key: INFO2
    value: "\u0422\u0435\u043A\u0441\u0442 \u0437\u0430\u043F\u0438\u0441\u043A\u0438:
      \xAB\u0421\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u0432\u044B\u0448\u043B\u0430
      \u0438\u0437 \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F.
      \u041F\u043E\u0434\u043E\u043F\u043E\u0442\u043D\u044B\u0435 \u043D\u043E\u0447\u044C\u044E
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u0441\u0430\u0431\u043E\u0442\u0430\u0436
      \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C \u043E\u0442\u0441\u0435\u043A\u0435.
      \u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F \u043E\u0431\u0440\u043E\u0441\u043B\u0430
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438. \u041C\u044B
      \u0441\u0440\u043E\u0447\u043D\u043E \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u043B\u0438
      \u044D\u0432\u0430\u043A\u0443\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443.\xBB "
  - key: INFO3
    value: "\u041E\u0440\u0443\u0434\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E \u043E\u0431\u0435\u0437\u0432\u0440\u0435\u0434\u0438\u0442\u044C
      \u044D\u0442\u0438\u0445 \u0442\u0432\u0430\u0440\u0435\u0439 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435. \u0423\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u043D\u0430 \u043F\u043E\u043B\u0443
      \u0432\u0435\u0434\u0443\u0442 \u043A \u043D\u0443\u0436\u043D\u043E\u043C\u0443
      \u043E\u0442\u0441\u0435\u043A\u0443."
  - key: INFO4
    value: "\u041A\u043B\u044E\u0447\u044C \u043E\u0442 \u0434\u0432\u0435\u0440\u0438
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432 \u043B\u0435\u0432\u043E\u043C
      \u043A\u0440\u044B\u043B\u0435 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u044D\u0442\u0430\u0436\u0435,
      \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E.
      \u0422\u0443\u0434\u0430 \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u0440\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u044D\u0442\u0438 \u043C\u0443\u0442\u0430\u043D\u0442\u044B. "
  - key: INFO4b
    value: 'This must open somehow. I''ll explore and see what I can find. '
  - key: INFO5
    value: I wonder what those massive door crystals are for? I should look around
      for some more switches.
